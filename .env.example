# Do NOT add NODE_ENV here: Vite treats it as an override for build mode even
# during `vite build`, so a value of "development" here silently produces a
# dev-mode frontend bundle (hardcoded API URL) in what should be a production
# build. NODE_ENV is set explicitly per-process instead: electron/main.js
# when it forks the server, and via cross-env in the electron:dev/db:init
# npm scripts. Never needed here.
VITE_API_URL=http://localhost:3000
PORT=3000
JWT_SECRET=your-random-secret-min-32-chars
CAP_API_URL=http://localhost:3001
LICENSE_PAYLOAD_SECRET=must-match-the-same-key-in-scola_desk_CAP
